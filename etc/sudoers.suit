# SUIT for Linux. The only sudo rights SUIT users need.
# The broker refuses unless an approved, unexpired grant exists, so this
# rule confers nothing on its own. Users must hold no other sudo rights;
# check with `suit doctor`, run as root.
Defaults!/usr/bin/suit-exec env_reset
Defaults!/usr/bin/suit env_reset
%suit-eligible  ALL=(root) NOPASSWD: /usr/bin/suit-exec, /usr/bin/suit request *, /usr/bin/suit revoke *, /usr/bin/suit status
%suit-approvers ALL=(root) /usr/bin/suit approve *, /usr/bin/suit deny *, /usr/bin/suit revoke *, /usr/bin/suit suspend *, /usr/bin/suit status, /usr/bin/suit verify
